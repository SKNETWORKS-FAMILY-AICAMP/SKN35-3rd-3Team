# `uv sync`는 이 파일이나 .env를 자동 생성하지 않습니다.
# `uv run python -m src.scripts.environment_setup`으로 안전하게 복사한 뒤
# 개인 환경에 맞게 값을 입력합니다. 기존 .env는 덮어쓰지 않습니다.
# 입력 후 같은 명령에 `--check`를 붙여 누락 설정을 다시 확인할 수 있습니다.
# 실제 .env와 API 키는 Git에 올리지 않습니다.

# 아래 키만 팀원 개인값입니다. 실제 값은 Git에 올리지 않습니다.
QDRANT_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# 일반적으로 OPENAI_API_KEY 또는 NVIDIA_API_KEY 중 하나만 입력합니다.
# 입력한 키에 따라 팀 고정 모델·차원·컬렉션을 자동 선택합니다.
# 두 키를 모두 보유했다면 사용할 제공자만 지정합니다.
# EMBEDDING_PROVIDER=openai

# 아래 값은 선택 항목입니다. 비우면 팀 공용 Qdrant Cloud 주소를 사용합니다.
# 로컬 Docker를 사용할 때만 http://localhost:6333으로 덮어씁니다.
QDRANT_URL=

# named vector를 사용할 때만 입력합니다. 단일 unnamed vector면 비워둡니다.
QDRANT_VECTOR_NAME=

# 기본 검색은 Dense + BM25 + RRF Hybrid입니다.
# 문제 비교나 Dense 단독 평가가 필요할 때만 dense로 바꿉니다.
SEARCH_MODE=hybrid

# 개인 GPU에서 로컬 Hugging Face 모델을 사용할 때만 아래를 설정합니다.
# 로컬 모델은 API 키로 구분할 수 없으므로 모델 규격을 명시합니다.
# Hybrid BM25와 공개 로컬 모델은 일반적으로 HF_TOKEN 없이 내려받을 수 있습니다.
# 최초 다운로드 제한을 완화하거나 비공개 모델을 쓸 때만 입력합니다.
# 비공개·승인형 모델을 사용할 때만 개인 Hugging Face 토큰을 입력합니다.
# HF_TOKEN=
# EMBEDDING_PROVIDER=local_huggingface
# EMBEDDING_MODEL=팀에서_정한_Hugging_Face_모델_ID
# EMBEDDING_DIMENSION=모델의_실제_출력_차원
# EMBEDDING_DEVICE=cuda
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOCUMENT_PREFIX=
# QDRANT_COLLECTION=team_documents_local_model_dev

# 검색 거리 방식은 팀 평가 후 확정합니다.
QDRANT_DISTANCE=cosine

# 연결 동작 설정입니다.
QDRANT_TIMEOUT_SECONDS=10
QDRANT_PREFER_GRPC=false
