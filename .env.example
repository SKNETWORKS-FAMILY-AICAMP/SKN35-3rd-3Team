# 이 파일을 .env로 복사한 뒤 개인 환경에 맞게 값을 입력합니다.
# 실제 .env와 API 키는 Git에 올리지 않습니다.

# 아래 키만 팀원 개인값입니다. 실제 값은 Git에 올리지 않습니다.
QDRANT_API_KEY=
OPENAI_API_KEY=

# NVIDIA 임베딩으로 전환할 때만 사용합니다.
NVIDIA_API_KEY=

# 아래 값은 선택 항목입니다. 비우면 src/const/vector_db_defaults.py의
# 팀 공용 설정을 사용합니다. 원격 주소가 확정되면 공용 설정 파일 한 곳만
# 수정하므로 팀원은 URL·모델·차원을 각자 다시 입력하지 않습니다.
QDRANT_URL=

# 팀에서 정한 개발용 또는 공유용 컬렉션 이름을 입력합니다.
QDRANT_COLLECTION=team_documents_openai_dev

# named vector를 사용할 때만 입력합니다. 단일 unnamed vector면 비워둡니다.
QDRANT_VECTOR_NAME=

# 텍스트 청크를 받을 때는 실제로 사용할 임베딩 모델 정보를 입력합니다.
# 미리 계산된 벡터를 받을 때도 해당 벡터를 만든 모델 정보를 입력합니다.
# 모델을 모르면 같은 규격의 질문 벡터를 만들 수 없어 검색을 검증할 수 없습니다.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_NORMALIZED=true

# 개인 GPU에서 로컬 Hugging Face 모델을 사용할 때만 설정합니다.
# EMBEDDING_PROVIDER=local_huggingface
# EMBEDDING_MODEL=팀에서_정한_Hugging_Face_모델_ID
# EMBEDDING_DIMENSION=모델의_실제_출력_차원
# EMBEDDING_DEVICE=cuda
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOCUMENT_PREFIX=
# QDRANT_COLLECTION=team_documents_local_model_dev

# 검색 거리 방식은 팀 평가 후 확정합니다.
QDRANT_DISTANCE=cosine

# 연결 동작 설정입니다.
QDRANT_TIMEOUT_SECONDS=10
QDRANT_PREFER_GRPC=false
