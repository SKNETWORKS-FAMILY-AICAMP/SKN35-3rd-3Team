{
  "source_id": "kca_case_1003640779",
  "title": "양도받은 필라테스 강습계약 해지에 따른 환급 요구",
  "document_type": "mediation_case",
  "source_url": "https://www.kca.go.kr/odr/bj/br/osBjDecisionExamDetW.do?brdId=00000007&dataStts=Y&seq=1003640779",
  "domain": "fitness_refund",
  "publisher": "한국소비자원",
